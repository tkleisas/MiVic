<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- ImGui.NET exposes native pointers, so the UI layer needs unsafe blocks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The client is a desktop game: invariant culture must not strip Greek rendering. -->
    <RootNamespace>MiVic.Game</RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <!--
      Fonts are loaded at runtime by ImGui rather than through the content
      pipeline, so they must sit next to the executable. Noto Sans is OFL
      licensed and carries full Greek coverage. NotoSansMath-UiSymbols.ttf is a
      subset of Noto Sans Math, OFL too, holding only the symbols Noto Sans has
      no glyph for; tools/build-ui-symbol-font.ps1 rebuilds it from the upstream
      font and the list in Ui/UiSymbols.cs.
    -->
    <None Include="Content\Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
    <!--
      Imported models are read at runtime by the in-house glTF loader, not by
      MGCB, so they ship as plain files next to the executable.
    -->
    <None Include="Content\Models\**\*.glb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Content\Models\**\*.gltf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Content\Models\**\*.bin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MiVic.Core\MiVic.Core.csproj" />
    <ProjectReference Include="..\MiVic.Audio\MiVic.Audio.csproj" />
    <!--
      The map writer: a picture of a match, drawn from simulation data with no
      graphics device involved. Referenced from the client because the probe is
      where a picture is asked for, not because the client draws with it — the
      renderer has never seen a line of it.
    -->
    <ProjectReference Include="..\MiVic.Map\MiVic.Map.csproj" />
  </ItemGroup>
  <Target Name="CompileEffects"
      BeforeTargets="RunContentBuilder"
      Inputs="Content\Shaders\InstancedMesh.fx;Content\Shaders\FogOverlay.fx"
      Outputs="Content\Shaders\InstancedMesh.mgfx;Content\Shaders\FogOverlay.mgfx">
    <!--
      The effects compile with ShadowDuskCLI — HLSL through DXC and SPIRV-Cross
      straight to GLSL, with every native binary shipped for every desktop platform —
      so the shader build needs no Wine and no Windows SDK anywhere. The tool comes
      from the project's own dotnet tool manifest (dotnet tool restore). The roll
      forward is the same one the rest of the build carries: the tool targets net8,
      the machine runs the newest SDK.
    -->
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildProjectDirectory)" IgnoreExitCode="false" />
    <Exec EnvironmentVariables="DOTNET_ROLL_FORWARD=Major"
        Command="dotnet tool run ShadowDuskCLI -- Content/Shaders/InstancedMesh.fx Content/Shaders/InstancedMesh.mgfx /Profile:OpenGL"
        WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec EnvironmentVariables="DOTNET_ROLL_FORWARD=Major"
        Command="dotnet tool run ShadowDuskCLI -- Content/Shaders/FogOverlay.fx Content/Shaders/FogOverlay.mgfx /Profile:OpenGL"
        WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
