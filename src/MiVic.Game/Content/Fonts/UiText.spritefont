<?xml version="1.0" encoding="utf-8"?>
<!--
  MonoGame SpriteFont for in-world text (unit labels, floating numbers).

  The character regions matter more than anything else here: MonoGame's default
  template covers only Basic Latin, so a Greek game renders as empty boxes
  without the Greek and Coptic range. Everything the HUD and world labels can
  print is listed explicitly.

  FontName resolves to NotoSans-Regular.ttf, which sits beside this file.
-->
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>NotoSans-Regular.ttf</FontName>
    <Size>22</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <DefaultCharacter>?</DefaultCharacter>
    <CharacterRegions>
      <!-- Basic Latin -->
      <CharacterRegion>
        <Start>&#x0020;</Start>
        <End>&#x007E;</End>
      </CharacterRegion>
      <!-- Latin-1 Supplement -->
      <CharacterRegion>
        <Start>&#x00A0;</Start>
        <End>&#x00FF;</End>
      </CharacterRegion>
      <!-- Greek and Coptic: the accented and unaccented monotonic alphabet -->
      <CharacterRegion>
        <Start>&#x0370;</Start>
        <End>&#x03FF;</End>
      </CharacterRegion>
      <!-- General Punctuation: dashes, quotes, ellipsis -->
      <CharacterRegion>
        <Start>&#x2000;</Start>
        <End>&#x206F;</End>
      </CharacterRegion>
      <!--
        Arrows (2190-21FF) and Mathematical Operators (2200-22FF) were listed here and are
        gone: Noto Sans has no glyph in either block, so neither region ever produced one.
        A region that cannot fill reads like coverage, which is how the interface came to
        draw √ and ▶ as boxes for months. A MonoGame SpriteFont is compiled from a single
        file and cannot merge a second, so a symbol that has to appear in world space needs
        a font carrying both it and the Greek. Every symbol the client draws is drawn by
        ImGui, and the self-test checks it against both font paths.
      -->
    </CharacterRegions>
  </Asset>
</XnaContent>
