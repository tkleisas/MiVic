# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
.vs/
.idea/

# Test and diagnostic artefacts
TestResults/
selftest-report.txt
crash.log
*.trx
shot*.png
top.png
wide.png
close.png
hashdump.txt

# Editor / tooling state, machine-specific
imgui.ini

# Imported 3D models are NOT committed.
# See src/MiVic.Game/Content/Models/README.md — run tools/fetch-assets.ps1 instead.
src/MiVic.Game/Content/Models/**/*.glb
src/MiVic.Game/Content/Models/**/*.gltf
src/MiVic.Game/Content/Models/**/*.bin

# ...except the ones we generate ourselves, which are ours to commit.
# Regenerate with tools/blender/build_all.ps1.
!src/MiVic.Game/Content/Models/Generated/
!src/MiVic.Game/Content/Models/Generated/*.glb

# Content pipeline intermediate output
src/MiVic.Game/Content/bin/
src/MiVic.Game/Content/obj/

# Blender scratch output
tools/blender/out/

# Model review sheets, and the shots they are built from
artifacts/
